{
  "name": "talshift-backend",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch --include .env src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/search.test.ts test/embeddings.test.ts test/professionalSearch.test.ts test/reputation.test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.13",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
